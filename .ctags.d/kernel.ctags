# 忽略其它无需索引的目录
--exclude=Documentation
--exclude=tools
--exclude=samples
--exclude=.git
--exclude=*.rst
--exclude=*.txt
--exclude=tools
--exclude=scripts
--exclude=rust
--exclude=drivers
--exclude=sound
--exclude=patch
--exclude=crypto
--exclude=security
--exclude=net
