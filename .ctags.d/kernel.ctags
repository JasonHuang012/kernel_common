--exclude=arch/arc
--exclude=arch/csky
--exclude=arch/hexagon
--exclude=arch/loongarch
--exclude=arch/m68k
--exclude=arch/microblaze
--exclude=arch/mips
--exclude=arch/nios2
--exclude=arch/openrisc
--exclude=arch/parisc
